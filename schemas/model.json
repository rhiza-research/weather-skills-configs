{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "eval"],
  "properties": {
    "schema_version": {"description": "The schema version the file was written for.", "const": 1},
    "model": {"$ref": "#/$defs/catalog_model"},
    "eval": {"$ref": "#/$defs/model_eval"}
  },
  "$defs": {
    "catalog_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "base_model_id",
        "name",
        "meta",
        "params",
        "access_control",
        "is_active",
        "enabled_by_default"
      ],
      "properties": {
        "id": {"type": "string"},
        "base_model_id": {"type": "string"},
        "name": {"type": "string"},
        "meta": {"$ref": "#/$defs/model_meta"},
        "params": {"type": "object"},
        "access_control": {"type": ["object", "null"]},
        "is_active": {"type": "boolean"},
        "enabled_by_default": {"type": "boolean"}
      }
    },
    "model_meta": {
      "type": "object",
      "required": ["profile_image_url", "description", "capabilities"],
      "properties": {
        "profile_image_url": {"type": ["string", "null"], "default": "/static/favicon.png"},
        "description": {"type": ["string", "null"], "default": null},
        "capabilities": {"type": ["object", "null"], "default": null}
      }
    },
    "model_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant"],
      "properties": {
        "variant": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
