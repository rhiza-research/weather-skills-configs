{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "models/<encoded id>.yaml",
  "description": "One catalog model. x-role marks app-input (passed to the app at startup) and eval-metadata (never reaches the app).",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "eval"],
  "properties": {
    "schema_version": {"description": "The schema version the file was written for.", "const": 1},
    "model": {"$ref": "#/$defs/catalog_model", "x-role": "app-input"},
    "eval": {"$ref": "#/$defs/model_eval", "x-role": "eval-metadata"}
  },
  "$defs": {
    "catalog_model": {
      "description": "One CATALOG_MODELS entry, as weather-skills-chat CatalogModelEntry accepts it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "base_model_id",
        "name",
        "meta",
        "params",
        "access_control",
        "is_active",
        "enabled_by_default",
        "organization_id",
        "visibility"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "\\S"},
        "base_model_id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "meta": {"$ref": "#/$defs/model_meta"},
        "params": {"type": "object"},
        "access_control": {"type": ["object", "null"], "default": null},
        "is_active": {"type": "boolean", "default": true},
        "enabled_by_default": {"type": "boolean", "default": true},
        "organization_id": {"description": "The app stores every catalog model in this organization.", "const": "platform"},
        "visibility": {"description": "The app stores every catalog model with this visibility.", "const": "public"}
      }
    },
    "model_meta": {
      "type": "object",
      "required": ["profile_image_url", "description", "capabilities"],
      "properties": {
        "profile_image_url": {"type": ["string", "null"], "default": "/static/favicon.png"},
        "description": {"type": ["string", "null"], "default": null},
        "capabilities": {"type": ["object", "null"], "default": null},
        "fallback_model_id": {"type": ["string", "null"]}
      }
    },
    "model_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant"],
      "properties": {
        "variant": {
          "description": "Experiment name suffix. Null for none.",
          "type": ["string", "null"],
          "pattern": "\\S",
          "default": null
        }
      }
    }
  }
}
