{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "connections"],
  "properties": {
    "schema_version": {"description": "The schema version the file was written for.", "const": 1},
    "connections": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/connection"}
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_call_tracing": {"type": "string"},
        "prefix_id": {"type": "string"}
      }
    }
  }
}
