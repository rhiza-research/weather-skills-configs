{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_packs"],
  "properties": {
    "schema_version": {"description": "The schema version the file was written for.", "const": 1},
    "skill_packs": {
      "type": "array",
      "items": {"$ref": "#/$defs/skill_pack"}
    }
  },
  "$defs": {
    "skill_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_url", "ref", "enabled_by_default", "is_active", "skills"],
      "properties": {
        "git_url": {
          "type": "string"
        },
        "ref": {"type": "string"},
        "enabled_by_default": {"type": "boolean"},
        "is_active": {"type": "boolean"},
        "skills": {
          "type": "array",
          "items": {"$ref": "#/$defs/skill"}
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "is_active", "enabled_by_default"],
      "properties": {
        "name": {"type": "string", "pattern": "\\S"},
        "is_active": {"type": "boolean", "default": true},
        "enabled_by_default": {"type": "boolean", "default": true}
      }
    }
  }
}
